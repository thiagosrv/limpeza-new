# ── Supabase ──────────────────────────────────────────────────────────────
# URL do projeto Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública anônima (Project Settings → API → anon public)
# Segura para expor no frontend — o acesso real é controlado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (Project Settings → API → service_role)
# NUNCA expor no frontend. Usada somente em Server Actions / Route Handlers
# para tarefas administrativas (ex.: criação de usuários admin).
SUPABASE_SERVICE_ROLE_KEY=

# Connection string do Postgres (Project Settings → Database → Connection
# string → "URI", modo "Session"). Usada apenas localmente pelos scripts
# `npm run db:migrate` / `npm run db:seed` — nunca é lida pela aplicação.
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# ── Aplicação ─────────────────────────────────────────────────────────────
# URL pública da aplicação (usada em metadados/PWA). Em produção: URL do Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
